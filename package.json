{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:global": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ops:smoke": "node scripts/ops/smoke-url.mjs",
    "structural:qualify": "node scripts/structural/qualify.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/starter-bundle.test.ts --exclude tests/moderation-rls.test.ts --exclude tests/chat-e2e.test.ts --exclude tests/realtime-messages.test.ts --exclude tests/messages-rls.test.ts",
    "test:supabase": "vitest run tests/starter-bundle.test.ts tests/moderation-rls.test.ts tests/chat-e2e.test.ts tests/realtime-messages.test.ts tests/messages-rls.test.ts",
    "test:all": "npm run test:unit && npm run test:supabase"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@lovable.dev/cloud-auth-js": "^1.1.2",
    "@noble/curves": "^2.2.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-plugin": "1.168.23",
    "@tanstack/zod-adapter": "^1.166.9",
    "face-api.js": "^0.22.2",
    "heic2any": "^0.0.4",
    "nitro": "3.0.260603-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite-tsconfig-paths": "^6.0.2",
    "web-push-neo": "^0.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.7.7",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
